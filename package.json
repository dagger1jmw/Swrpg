{
  "name": "swrpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run lore",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run lore",
    "preview": "vite preview",
    "test": "vitest run --exclude \"tests/lifetime/**\" --exclude \"tests/sweep/**\" --exclude \"tests/spread/**\" --exclude \"tests/severs/**\" --exclude \"tests/mortals/**\" --exclude \"tests/forcexp/**\" --exclude \"tests/paces/**\" --exclude \"tests/missions/**\" --exclude \"tests/lifegap/**\"",
    "pretest": "npm run lore",
    "test:lifetime": "vitest run tests/lifetime",
    "pretest:lifetime": "npm run lore",
    "test:all": "vitest run --exclude \"tests/sweep/**\" --exclude \"tests/spread/**\" --exclude \"tests/severs/**\" --exclude \"tests/mortals/**\" --exclude \"tests/forcexp/**\" --exclude \"tests/paces/**\" --exclude \"tests/missions/**\" --exclude \"tests/lifegap/**\"",
    "pretest:all": "npm run lore",
    "sweep": "vitest run tests/sweep --silent=false",
    "presweep": "npm run lore",
    "spread": "vitest run --config vitest.spread.config.ts --silent=false",
    "severs": "vitest run --config vitest.severs.config.ts --silent=false",
    "mortals": "vitest run --config vitest.mortals.config.ts --silent=false",
    "paces": "vitest run tests/paces --exclude \"tests/paces/k.test.ts\" --silent=false",
    "ksolve": "vitest run tests/paces/k.test.ts --silent=false",
    "prespread": "npm run lore",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run lore",
    "lint": "eslint .",
    "lifegap": "vitest run --config vitest.lifegap.config.ts --silent=false",
    "missions": "vitest run --config vitest.missions.config.ts --silent=false",
    "lore": "node scripts/build-lore.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
